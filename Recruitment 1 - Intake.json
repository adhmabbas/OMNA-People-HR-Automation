    {
      "parameters": {
        "jsCode": "const item = $input.first();\nif (!item) return [];\n\nconst f = item.json || {};\nconst errors = [];\n\nconst name = String(f['Full Name'] || '').trim().replace(/\\s+/g, ' ');\nconst email = String(f.Email || '').trim().toLowerCase();\nconst position = String(f.Position || '').trim();\nconst motivation = String(f['Why do you want this job?'] || '').trim();\n\nconst allowed = [\n  'AI Automation Engineer (Junior)',\n  'Data Analyst',\n  'Customer Support Specialist'\n];\n\nif (name.length < 3 || name.split(' ').length < 2 || !/^[\\p{L} .'-]+$/u.test(name)) {\n  errors.push('Please enter your full name (first and last name, letters only).');\n}\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) {\n  errors.push('Please enter a valid email address.');\n}\n\nif (!allowed.includes(position)) {\n  errors.push('Please choose one of the listed positions.');\n}\n\nif (motivation.length > 1500) {\n  errors.push('Please keep your motivation under 1500 characters.');\n}\n\nif (!item.binary || !item.binary.CV) {\n  errors.push('Please attach your CV.');\n} else {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'CV');\n  \n  if (buf.subarray(0, 5).toString('utf8') !== '%PDF-') {\n    errors.push('Your CV must be a real PDF file (renaming a Word file to .pdf does not work).');\n  }\n  if (buf.length > 5 * 1024 * 1024) {\n    errors.push('Your CV must be smaller than 5 MB.');\n  }\n  if (buf.length < 500) {\n    errors.push('Your CV file looks empty or damaged. Please export it again.');\n  }\n}\n\nreturn [{\n  json: {\n    name,\n    email,\n    position,\n    motivation,\n    valid: errors.length === 0,\n    errors,\n    errorText: errors.map(e => '- ' + e).join('\\n')\n  },\n  binary: item.binary,\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
