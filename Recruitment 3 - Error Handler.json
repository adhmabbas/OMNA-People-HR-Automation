      "parameters": {
        "jsCode": "// DAILY DIGEST: one summary of the last 24 hours plus\n// everything still open.\n\nconst num = v => Number(String(v ?? '').replace(/,/g, ''));\n\nconst nowMin = Math.floor(Date.now() / 60000);\n\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r.Fingerprint);\n\nconst last24 = rows.filter(r => {\n  const diff = nowMin - num(r['Epoch Minute']);\n  return diff >= 0 && diff <= 1440;\n});\n\nconst open = rows.filter(r =>\n  String(r.Status || '').toLowerCase() === 'open'\n);\n\n// Count items by type\nconst count = (list, key) => list.reduce((acc, r) => {\n  const value = r[key] || 'Unknown';\n  acc[value] = (acc[value] || 0) + 1;\n  return acc;\n}, {});\n\n// Sort types by count (descending)\nconst byType = Object.entries(count(last24, 'Type'))\n  .sort((a, b) => b[1] - a[1]);\n\n// Group open errors by fingerprint\nconst groups = Object.values(open.reduce((acc, r) => {\n  acc[r.Fingerprint] = acc[r.Fingerprint] || {\n    ...r,\n    times: 0\n  };\n\n  acc[r.Fingerprint].times++;\n\n  return acc;\n}, {}));\n\n// HTML escape helper\nconst esc = s => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;')\n  .replace(/'/g, '&#39;');\n\n// Error types HTML\nconst typeRows = byType\n  .map(([t, n]) => `<li><b>${esc(t)}</b>: ${n}</li>`)\n  .join('') || '<li>None</li>';\n\n// Open errors HTML\nconst openRows = groups.map(g =>\n  `<li>\n    <b>${esc(g.Workflow)}</b> at ${esc(g.Node)}\n    (${esc(g.Type)}, ${esc(g.Severity)})\n    &times;${g.times}<br>\n    <span style=\"color:#6b7280;\">\n      ${esc(g.Message)}\n    </span><br>\n    <i>${esc(g['Suggested Fix'])}</i>\n  </li>`\n).join('');\n\n// Return summary\nreturn [{\n  json: {\n    hasNews: last24.length > 0 || open.length > 0,\n    total24h: last24.length,\n    critical24h: last24.filter(\n      r => String(r.Severity || '').toLowerCase() === 'critical'\n    ).length,\n    openCount: open.length,\n    typeListHtml: typeRows,\n    openListHtml: openRows || '<li>Nothing open. Good job.</li>',\n  }\n}];\n"
      },
