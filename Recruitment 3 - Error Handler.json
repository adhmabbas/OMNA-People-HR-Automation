    {
      "parameters": {
        "jsCode": "const MAX_WAIT_HOURS = 3;\nconst now = DateTime.now().setZone('Africa/Cairo');\n\n// Parse application date\nconst parse = s => {\n  if (!s) return null;\n\n  s = String(s).trim();\n\n  const formats = [\n    'yyyy-MM-dd HH:mm',\n    'yyyy-MM-dd HH:mm:ss',\n    'M/d/yyyy H:mm:ss',\n    'M/d/yyyy H:mm'\n  ];\n\n  for (const f of formats) {\n    const d = DateTime.fromFormat(s, f, {\n      zone: 'Africa/Cairo'\n    });\n\n    if (d.isValid) return d;\n  }\n\n  const d = DateTime.fromISO(s, {\n    zone: 'Africa/Cairo'\n  });\n\n  if (d.isValid) return d;\n\n  return null;\n};\n\n// HTML escape\nconst esc = s => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;')\n  .replace(/'/g, '&#39;');\n\n// Find applicants waiting too long\nconst stuck = $input.all()\n  .map(i => i.json)\n  .filter(r => String(r.Status || '').trim().toLowerCase() === 'new')\n  .map(r => ({\n    name: r.Name || 'Unknown',\n    position: r.Position || 'Not specified',\n    applied: parse(r['Applied At'])\n  }))\n  .filter(r => {\n    if (!r.applied) return false;\n\n    const hours = now.diff(r.applied, 'hours').hours;\n\n    return hours > MAX_WAIT_HOURS && hours >= 0;\n  });\n\n// Oldest waiting time\nconst oldestHours = stuck.length\n  ? Math.floor(Math.max(\n      ...stuck.map(r => now.diff(r.applied, 'hours').hours)\n    ))\n  : 0;\n\n// Generate HTML list\nconst listHtml = stuck.slice(0, 10).map(r =>\n  `<li>\n    <strong>${esc(r.name)}</strong>\n    (${esc(r.position)}) —\n    Applied: ${r.applied.toFormat('yyyy-MM-dd HH:mm')}\n  </li>`\n).join('');\n\n// Return data\nreturn [{\n  json: {\n    isStuck: stuck.length > 0,\n    stuckCount: stuck.length,\n    oldestHours,\n    listHtml: listHtml || '<li>No pending applicants.</li>',\n    time: now.toFormat('yyyy-MM-dd HH:mm'),\n    epochMinute: Math.floor(Date.now() / 60000)\n  }\n}];\n"
      },
